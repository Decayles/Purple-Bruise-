:root {
  --text: #ffffff;
  --none: #332238;
  --g: #2a5235;
  --t: #8a631c;
  --m: #8c4217;
  --e: #7a1823;
  --ff: #7a1843;
  --fm: #69187a;
  --gen: #2a5235;
  --mm: #1c387a;
  --other: #231b24;
  --cntw: #5c2552;
  --warn: #7a1823;
  --ext: #1a435c;
  --wip: #571a2d;
  --fin: #2a5235;
}

.blurb .header:has(ul.required-tags) .heading {
  margin-left: 0 !important;
}

.blurb ul.required-tags,
.blurb ul.required-tags li,
.blurb ul.required-tags li a,
.blurb ul.required-tags li span,
.blurb ul.required-tags li + li + li,
.blurb ul.required-tags li + li + li + li {
  display: block !important;
  position: unset !important;
  width: unset !important;
  height: unset !important;
  margin: unset !important;
  padding: unset !important;
  border: unset !important;
  background: unset !important;
  font-size: 0.85em !important;
  font-weight: bold !important;
  text-transform: capitalize !important;
  line-height: 1 !important;
  color: var(--text) !important;
}

.blurb ul.required-tags {
  display: flex !important;
  flex-wrap: wrap !important;
  column-gap: 0.35em !important;
  margin-top: 0.35em !important;
  margin-bottom: 0.5em !important;
}

.blurb ul.required-tags > li > a > span.warnings,
.blurb ul.required-tags > li > a > span:not(:is(.warning-yes,
.warning-choosenotto))::before {
  display: block !important;
  margin-block: 0.15em !important;
  padding-block: 0.3em !important;
  padding-inline: 0.5em !important;
  border-radius: 4px !important;
}

.blurb ul.required-tags > li > a > span:not(.warnings) > span.text {
  display: none !important;
}

.index:not(.prompt) .blurb ul.required-tags > li:has(.warnings):not(:has(.warning-yes,
.warning-choosenotto)),
.index:not(.prompt) .blurb ul.required-tags > li > a > :is(.warning-yes,
.warning-choosenotto) > span.text {
  display: none !important;
}

.required-tags .warning-choosenotto {
  background: var(--cntw) !important;
}

.index:not(.prompt) .required-tags .warning-choosenotto::before {
  content: "CNTW";
}

.required-tags .warning-yes {
  background: var(--warn) !important;
}

.index:not(.prompt) .required-tags .warning-yes::before {
  content: "Warnings";
}

.required-tags .warning-no {
  background: var(--none) !important;
}

.required-tags .external-work::before {
  content: "External Work";
  background: var(--ext) !important;
}

.required-tags .complete-no[Title*="in Progress" i]::before {
  content: "WIP";
  background: var(--wip) !important;
}

.required-tags .complete-no[Title*="Unfulfilled" i]::before {
  content: "Unfulfilled";
  background: var(--wip) !important;
}

.required-tags .complete-yes[Title*="Complete" i]::before {
  content: "Complete";
  background: var(--fin) !important;
}

.required-tags .complete-yes[Title*="Filled" i]::before {
  content: "Fulfilled";
  background: var(--fin) !important;
}

.required-tags .category-femslash::before {
  content: "F/F";
  background: var(--ff) !important;
}

.required-tags .category-het::before {
  content: "F/M";
  background: var(--fm) !important;
}

.required-tags .category-gen::before {
  content: "Gen";
  background: var(--gen) !important;
}

.required-tags .category-slash::before {
  content: "M/M";
  background: var(--mm) !important;
}

.required-tags .category-multi::before {
  content: "Multi";
  background: linear-gradient(to right, var(--ff), var(--fm), var(--mm), var(--gen)) !important;
}

.required-tags .category-other::before {
  content: "Other";
  background: var(--other) !important;
}

.required-tags .category-none::before {
  content: "No Category";
  background: var(--none) !important;
}

.required-tags .category[Title*="F/F" i][Title*="F/M" i]::before {
  content: "F/F, F/M";
  background: linear-gradient(to right, var(--ff), var(--fm)) !important;
}

.required-tags .category[Title*="F/F" i][Title*="Gen" i]::before {
  content: "F/F, Gen";
  background: linear-gradient(to right, var(--ff), var(--gen)) !important;
}

.required-tags .category[Title*="F/F" i][Title*="M/M" i]::before {
  content: "F/F, M/M";
  background: linear-gradient(to right, var(--ff), var(--mm)) !important;
}

.required-tags .category[Title*="F/F" i][Title*="Other" i]::before {
  content: "F/F, Other";
  background: linear-gradient(to right, var(--ff), var(--other)) !important;
}

.required-tags .category[Title*="F/M" i][Title*="Gen" i]::before {
  content: "F/M, Gen";
  background: linear-gradient(to right, var(--fm), var(--gen)) !important;
}

.required-tags .category[Title*="F/M" i][Title*="M/M" i]::before {
  content: "F/M, M/M";
  background: linear-gradient(to right, var(--fm), var(--mm)) !important;
}

.required-tags .category[Title*="F/M" i][Title*="Other" i]::before {
  content: "F/M, Other";
  background: linear-gradient(to right, var(--fm), var(--other)) !important;
}

.required-tags .category[Title*="M/M" i][Title*="Gen" i]::before {
  content: "M/M, Gen";
  background: linear-gradient(to right, var(--mm), var(--gen)) !important;
}

.required-tags .category[Title*="Gen" i][Title*="Other" i]::before {
  content: "Gen, Other";
  background: linear-gradient(to right, var(--gen), var(--other)) !important;
}

.required-tags .category[Title*="M/M" i][Title*="Other" i]::before {
  content: "M/M, Other";
  background: linear-gradient(to right, var(--mm), var(--other)) !important;
}

.required-tags .rating-general-audience::before {
  content: "Gen";
  background: var(--g) !important;
}

.required-tags .rating-teen::before {
  content: "Teen";
  background: var(--t) !important;
}

.required-tags .rating-mature::before {
  content: "Mature";
  background: var(--m) !important;
}

.required-tags .rating-explicit::before {
  content: "Explicit";
  background: var(--e) !important;
}

.required-tags .rating-notrated::before {
  content: "Not Rated";
  background: var(--none) !important;
}

.required-tags .rating[Title*="Gen" i][Title*="Teen" i]::before {
  content: "Gen, Teen";
  background: linear-gradient(to right, var(--g), var(--t)) !important;
}

.required-tags .rating[Title*="Gen" i][Title*="Mature" i]::before {
  content: "Gen, Mature";
  background: linear-gradient(to right, var(--g), var(--m)) !important;
}

.required-tags .rating[Title*="Gen" i][Title*="Explicit" i]::before {
  content: "Gen, Explicit";
  background: linear-gradient(to right, var(--g), var(--e)) !important;
}

.required-tags .rating[Title*="Teen" i][Title*="Mature" i]::before {
  content: "Teen, Mature";
  background: linear-gradient(to right, var(--t), var(--m)) !important;
}

.required-tags .rating[Title*="Teen" i][Title*="Explicit" i]::before {
  content: "Teen, Explicit";
  background: linear-gradient(to right, var(--t), var(--e)) !important;
}

.required-tags .rating[Title*="Mature" i][Title*="Explicit" i]::before {
  content: "Mature, Explicit";
  background: linear-gradient(to right, var(--m), var(--e)) !important;
}

