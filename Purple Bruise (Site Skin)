:root {
  --text: #ffffff;
  --none: #332238;
  --g: #2a5235;
  --t: #8a631c;
  --m: #8c4217;
  --e: #7a1823;
  --ff: #7a1843;
  --fm: #69187a;
  --gen: #2a5235;
  --mm: #1c387a;
  --other: #231b24;
  --cntw: #5c2552;
  --warn: #7a1823;
  --ext: #1a435c;
  --wip: #571a2d;
