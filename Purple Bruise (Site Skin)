}

.required-tags .category[Title*="F/F" i][Title*="F/M" i]::before {
  content: "F/F, F/M";
  background: linear-gradient(to right, var(--ff), var(--fm)) !important;
}

.required-tags .category[Title*="F/F" i][Title*="Gen" i]::before {
