  background: var(--t) !important;
}

.required-tags .rating-mature::before {
  content: "Mature";
  background: var(--m) !important;
}

.required-tags .rating-explicit::before {
  content: "Explicit";
  background: var(--e) !important;
}

.required-tags .rating-notrated::before {
  content: "Not Rated";
  background: var(--none) !important;
}

.required-tags .rating[Title*="Gen" i][Title*="Teen" i]::before {
  content: "Gen, Teen";
  background: linear-gradient(to right, var(--g), var(--t)) !important;
}

.required-tags .rating[Title*="Gen" i][Title*="Mature" i]::before {
  content: "Gen, Mature";
  background: linear-gradient(to right, var(--g), var(--m)) !important;
