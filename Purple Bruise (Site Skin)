}

.required-tags .category[Title*="F/F" i][Title*="Other" i]::before {
  content: "F/F, Other";
  background: linear-gradient(to right, var(--ff), var(--other)) !important;
}

.required-tags .category[Title*="F/M" i][Title*="Gen" i]::before {
  content: "F/M, Gen";
  background: linear-gradient(to right, var(--fm), var(--gen)) !important;
}

.required-tags .category[Title*="F/M" i][Title*="M/M" i]::before {
  content: "F/M, M/M";
  background: linear-gradient(to right, var(--fm), var(--mm)) !important;
}

.required-tags .category[Title*="F/M" i][Title*="Other" i]::before {
  content: "F/M, Other";
  background: linear-gradient(to right, var(--fm), var(--other)) !important;
}

.required-tags .category[Title*="M/M" i][Title*="Gen" i]::before {
  content: "M/M, Gen";
  background: linear-gradient(to right, var(--mm), var(--gen)) !important;
}

.required-tags .category[Title*="Gen" i][Title*="Other" i]::before {
