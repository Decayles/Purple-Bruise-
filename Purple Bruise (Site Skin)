html,
body,
#outer,
#wrapper,
#container {
  max-width: 100% !important;
  overflow-x: hidden !important;
}

html,
body,
#outer,
#wrapper,
#main {
  background-color: #181219 !important;
  background-image: radial-gradient(circle at 15% 20%, rgba(75, 0, 130, 0.25) 0%, transparent 40%),
    radial-gradient(circle at 85% 75%, rgba(138, 43, 226, 0.2) 0%, transparent 45%),
    radial-gradient(circle at 50% 50%, rgba(178, 34, 34, 0.15) 0%, transparent 60%) !important;
  background-attachment: fixed !important;
  min-height: 100vh !important;
  color: #e2d7e5 !important;
}

#main {
  position: static !important;
  margin-left: auto !important;
  margin-right: auto !important;
  padding-left: 0.5em !important;
  padding-right: 0.5em !important;
  box-sizing: border-box !important;
}

#main.with-sidebar {
  display: block !important;
  padding-left: 0 !important;
  padding-right: 0 !important;
}

#workskin,
div.wrapper,
#outer.wrapper,
#inner.wrapper {
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  color: #e2d7e5 !important;
}

#main .heading,
#main .heading a,
#main .heading a:visited,
#main h2.heading,
#main h2.heading a,
#main h2.heading a:visited,
