  background: linear-gradient(to right, var(--gen), var(--other)) !important;
}

.required-tags .category[Title*="M/M" i][Title*="Other" i]::before {
  content: "M/M, Other";
  background: linear-gradient(to right, var(--mm), var(--other)) !important;
}

.required-tags .rating-general-audience::before {
  content: "Gen";
  background: var(--g) !important;
}

.required-tags .rating-teen::before {
