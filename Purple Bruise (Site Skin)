}

.blurb .header:has(ul.required-tags) .heading {
  margin-left: 0 !important;
}

.blurb .header h4.heading a,
.blurb .header .heading a {
  color: #e2d7e5 !important;
  text-decoration: none !important;
  border-bottom: 1px solid #5c3966 !important;
