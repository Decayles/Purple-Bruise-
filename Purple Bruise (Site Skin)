  background: var(--ext) !important;
}

.required-tags .category-femslash::before {
  content: "F/F";
  background: var(--ff) !important;
}

.required-tags .category-het::before {
  content: "F/M";
  background: var(--fm) !important;
}

.required-tags .category-gen::before {
  content: "Gen";
  background: var(--gen) !important;
}

.required-tags .category-slash::before {
  content: "M/M";
  background: var(--mm) !important;
}

.required-tags .category-multi::before {
  content: "Multi";
