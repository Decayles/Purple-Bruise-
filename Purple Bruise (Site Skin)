  display: inline !important;
}

.blurb .datetime,
li.blurb .datetime,
.blurb p.datetime,
.blurb .header .datetime,
.blurb .header p.datetime {
  position: absolute !important;
  bottom: 10px !important;
  right: 15px !important;
  top: auto !important;
  margin: 0 !important;
  padding: 0 !important;
  font-size: 0.78em !important;
  color: #e2d7e5 !important;
  z-index: 20 !important;
  background: transparent !important;
  white-space: nowrap !important;
}

.blurb ul.required-tags,
li.blurb ul.required-tags,
.work.blurb .required-tags {
  display: flex !important;
  flex-direction: row !important;
  justify-content: center !important;
  align-items: center !important;
  flex-wrap: wrap !important;
  position: relative !important;
  top: auto !important;
  left: auto !important;
  right: auto !important;
  float: none !important;
  width: 100% !important;
  margin: 8px auto !important;
  padding: 0 !important;
  height: auto !important;
  text-align: center !important;
  column-gap: 0.35em !important;
}

.blurb ul.required-tags li {
  display: inline-block !important;
  position: relative !important;
  top: auto !important;
  left: auto !important;
  margin: 0 3px !important;
  padding: 0 !important;
  width: auto !important;
  height: auto !important;
  background: transparent none !important;
}

.blurb ul.required-tags li *,
.blurb ul.required-tags li a,
.blurb ul.required-tags li span {
  background: transparent none !important;
  border: none !important;
  box-shadow: none !important;
  width: auto !important;
  height: auto !important;
  min-width: 0 !important;
  min-height: 0 !important;
  position: static !important;
}

.blurb ul.required-tags li a,
.blurb ul.required-tags li span,
.blurb ul.required-tags .text,
.blurb ul.required-tags .warnings {
  font-size: 0 !important;
  color: transparent !important;
  line-height: 0 !important;
}

.required-tags span::before,
.required-tags a::before,
.required-tags li span::before {
  display: inline-block !important;
  padding: 1px 4px !important;
  border-radius: 3px !important;
  font-size: 0.58rem !important;
  font-weight: 700 !important;
  line-height: 1.1 !important;
  color: #ffffff !important;
  text-shadow: none !important;
  white-space: nowrap !important;
}

.required-tags .warning-choosenotto {
  background: var(--cntw) !important;
}

.index:not(.prompt) .required-tags .warning-choosenotto::before {
  content: "CNTW";
  background: var(--cntw) !important;
}

.required-tags .warning-yes {
  background: var(--warn) !important;
}

.index:not(.prompt) .required-tags .warning-yes::before {
  content: "Warnings";
  background: var(--warn) !important;
}

.required-tags .warning-no::before {
  content: "No Warnings";
  background: var(--none) !important;
}

.required-tags .iswip::before,
.required-tags .complete-no::before,
.required-tags .complete-no[Title*="in Progress" i]::before,
.required-tags .complete-no[Title*="Unfulfilled" i]::before {
  content: "WIP";
  background: var(--wip) !important;
}

.required-tags .iscomplete::before,
.required-tags .complete-yes::before,
.required-tags .complete-yes[Title*="Complete" i]::before,
.required-tags .complete-yes[Title*="Filled" i]::before {
