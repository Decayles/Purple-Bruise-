}

.required-tags .warning-choosenotto::before {
  content: "CNTW";
  background: var(--cntw) !important;
}

.required-tags .warning-yes::before {
  content: "Warnings";
  background: var(--warn) !important;
}

.required-tags .warning-no::before {
  content: "No Warnings";
  background: var(--none) !important;
}

.required-tags .iswip::before,
.required-tags .complete-no::before {
  content: "WIP";
  background: var(--wip) !important;
}

.required-tags .iscomplete::before,
.required-tags .complete-yes::before {
  content: "Complete";
  background: var(--fin) !important;
}

.required-tags .external-work::before {
  content: "External";
  background: var(--ext) !important;
}

.required-tags .category-femslash::before {
  content: "F/F";
  background: var(--ff) !important;
}

.required-tags .category-het::before {
  content: "F/M";
  background: var(--fm) !important;
}

.required-tags .category-gen::before {
  content: "Gen";
  background: var(--gen) !important;
}

.required-tags .category-slash::before {
  content: "M/M";
  background: var(--mm) !important;
}

.required-tags .category-multi::before {
  content: "Multi";
  background: linear-gradient(to right, var(--ff), var(--fm), var(--mm), var(--gen)) !important;
}

.required-tags .category-other::before {
  content: "Other";
  background: var(--other) !important;
}

.required-tags .category-none::before {
  content: "No Category";
  background: var(--none) !important;
}

.required-tags .rating-general-audience::before {
  content: "Gen";
  background: var(--g) !important;
}

.required-tags .rating-teen::before {
  content: "Teen";
  background: var(--t) !important;
}

.required-tags .rating-mature::before {
  content: "Mature";
  background: var(--m) !important;
}

.required-tags .rating-explicit::before {
  content: "Explicit";
  background: var(--e) !important;
}

.required-tags .rating-notrated::before {
  content: "Not Rated";
